{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Read(~/Dokumente/**)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "env": {
    "DISABLE_AUTO_COMPACT": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/example/.claude/hooks/check-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model": "opus"
}
